{
  "name": "@zythegit/evokit",
  "version": "0.4.7",
  "description": "EvoKit — Self-Evolving System Framework for AI Coding Assistants",
  "keywords": [
    "claude",
    "ai",
    "coding-assistant",
    "evolution",
    "self-evolving",
    "memory",
    "framework"
  ],
  "homepage": "https://github.com/zyTheGit/EvoKit",
  "bugs": {
    "url": "https://github.com/zyTheGit/EvoKit/issues"
  },
  "license": "MIT",
  "author": "zyTheGit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyTheGit/EvoKit.git"
  },
  "type": "module",
  "bin": {
    "evokit": "./bin/evokit.cjs"
