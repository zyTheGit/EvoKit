    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^18.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
