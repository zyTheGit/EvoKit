{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "__HOME__/.config/opencode/memory/learned-rules.md"
  ],
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:./AGENTS.md}"
    },
    "architect": {
      "mode": "subagent",
      "prompt": "{file:__HOME__/.config/opencode/agent/architect.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "reviewer": {
      "mode": "subagent",
      "prompt": "{file:__HOME__/.config/opencode/agent/reviewer.md}",
      "tools": {
        "write": "ask",
        "edit": "ask",
        "bash": false
      }
    }
  },
  "permission": {
    "evokit-boot": "allow",
    "evokit-evolve": "allow",
    "evokit-memory": "allow",
    "evokit-session": "allow"
  }
}
