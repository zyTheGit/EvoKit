{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "__HOME__/.evokit/knowledge/knowledge-index.md"],
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:./AGENTS.md}"
    },
    "architect": {
      "mode": "subagent",
      "prompt": "{file:__HOME__/.config/opencode/agent/architect.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "prompt": "{file:__HOME__/.config/opencode/agent/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "permission": {
    "evokit-boot": "allow",
    "evokit-learn": "allow",
    "evokit-session": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  }
}
