{
  "rules": [
    {
      "pattern": "(^|[;&|])\\s*rm\\s+-rf\\s+(\\/|~\\/\\.|\\$HOME\\/\\.)",
      "message": "禁止对受保护路径执行 rm -rf"
    },
    {
      "pattern": "git\\s+push\\s+.*(--force|-f)\\b",
      "message": "禁止 git push --force（请使用 --force-with-lease）"
    },
    {
      "pattern": "git\\s+reset\\s+--hard\\b",
      "message": "禁止 git reset --hard（请使用 --soft 或 --mixed）"
    },
    {
      "pattern": "chmod\\s+-R\\s+777\\b",
      "message": "chmod -R 777 存在安全风险"
    }
  ]
}
